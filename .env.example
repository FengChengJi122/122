# =========================================================
# AI Multi-Agent Desktop Companion — Environment Variables
# =========================================================
# Copy this file to .env and fill in your values.

# --- LLM API ---
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=1024

# --- WebSocket Server ---
WS_HOST=localhost
WS_PORT=8765

# --- ChromaDB ---
CHROMA_DIR=./chroma_db
